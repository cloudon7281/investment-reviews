#!/bin/sh
set -eu
#
# scripts/test — this repository's test entry point (devops-model#143 §B5).
#
# DO NOT EDIT THIS FILE HERE. It is byte-identical in every repository in the estate, tier-1-ci holds the
# canonical text, and tier-1-ci's daily sweep reports any repository whose copy has drifted from it.
#
# None of the behaviour is here. The mandated tests/ layout, the interpreter resolved from this
# repository's own `requires-python`, and the .venv built from its own manifests all live in tier-1-ci's
# lib/run-tests, so that policy is changed in one file rather than in twenty.
#
# What this file does is find tier-1-ci, which every repository's tests depend on and which therefore has
# to be located rather than assumed:
#
#   1. in this repository    — tier-1-ci itself
#   2. the installed release — how it is found on jarvis, including inside a sweep's throwaway clone
#   3. the dev clone         — the canonical working copy, which §8.2 puts on both hosts
#
# If none of them is present this exits 1 and says so. It does NOT fall back to running pytest against
# whatever `python3` is on PATH: a suite that runs on an unknown interpreter with unknown dependencies
# answers a question nobody asked, and reports green for it (§8.12).

REPO="$(cd "$(dirname "$0")/.." && pwd)"

for candidate in \
    "$REPO/lib/run-tests" \
    "/Users/cl/srv/tier-1-ci/current/lib/run-tests" \
    "/Users/cl/dev/tier-1-ci/lib/run-tests"
do
    if [ -x "$candidate" ]; then exec "$candidate" "$REPO"; fi
done

echo "scripts/test: FAIL — cannot find tier-1-ci's lib/run-tests." >&2
echo "  Looked in: $REPO/lib, /Users/cl/srv/tier-1-ci/current/lib, /Users/cl/dev/tier-1-ci/lib" >&2
echo "  Fix: install tier-1-ci on this host, or clone it to /Users/cl/dev/tier-1-ci (§8.2 puts dev" >&2
echo "  clones on both hosts). Guessing an interpreter instead is what §8.12 forbids." >&2
exit 1
